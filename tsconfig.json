{
  "compilerOptions": {
    "module": "commonjs",
    "lib": ["es2015", "es2017", "dom"],
    "target": "es5",
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false
  },
  "exclude": ["node_modules", "cloudfunctions"]
}
